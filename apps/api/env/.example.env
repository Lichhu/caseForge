NODE_ENV=development
PORT=34550

REQ_DOC_SKILL_URL=http://localhost:9001/case-forge/require-skill.md
CASE_DOC_SKILL_URL=http://localhost:9001/case-forge/case-skill.md

MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=case-forge
MINIO_PATH_PREFIX=documents

AI_WORKFLOW_INVOKE_URL=
AI_WORKFLOW_STOP_URL=
AI_WORKFLOW_ID=

TYPEORM_HOST=localhost
TYPEORM_PORT=3306
TYPEORM_USERNAME=root
TYPEORM_PASSWORD=
TYPEORM_DATABASE=case_forge

# service management platform (SMP) integration
# 未配置 SMP_URL 或设置 SMP_DEMO_MODE=true 时启用 demo 模式
SMP_URL=
SMP_SERVICE_INFO_LIST=serviceManagementGovernanceController/selectServiceInfoList
SMP_CALL_SERVICE_INFO_LIST=serviceManagementGovernanceController/selectCallServiceInfoList
SMP_TEST_INFO_LIST=serviceManagementGovernanceController/selectTestInfoList
SMP_CHANGE_INFO_BY_REQCODE=serviceManagementGovernanceController/selectChangeInfoByReqCode
SMP_DEMO_MODE=true
SMP_REQUEST_TIMEOUT_MS=30000

# requirement platform sync
# 需求平台定时同步间隔（毫秒），0 关闭定时同步，仅手动同步
REQUIREMENT_SYNC_INTERVAL_MS=600000

# 敏行消息推送（OCU）：enabled=false 时仅输出日志不真实发送
OCU_PUSH_ENABLED=false
OCU_PUSH_URL=http://36.114.30.72:8888/api/v1/ocu/sendMessage
OCU_ID=
OCU_SECRET=
OCU_SERVER_URL=
OCU_BEARER_TOKEN=
OCU_PORTAL_BASE_URL=http://localhost:33550
OCU_OVERDUE_SCAN_INTERVAL_MS=600000

# 消息发送（先落库 notify_message，默认未发送，由轮询任务读取后推送）
# 未发送消息轮询间隔（毫秒），0 关闭定时轮询（仅入队时触发发送）
NOTIFY_SCAN_INTERVAL_MS=30000
# 单轮最多拉取的消息条数
NOTIFY_BATCH_SIZE=50
# 发送失败最大重试次数，超过后标记 failed 不再发送
NOTIFY_MAX_RETRY=3
