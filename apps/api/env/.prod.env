# 消息发送（先落库 notify_message，默认未发送，由轮询任务读取后推送）
# 未发送消息轮询间隔（毫秒），0 关闭定时轮询（仅入队时触发发送）
NOTIFY_SCAN_INTERVAL_MS=30000
# 单轮最多拉取的消息条数
NOTIFY_BATCH_SIZE=50
# 发送失败最大重试次数，超过后标记 failed 不再发送
NOTIFY_MAX_RETRY=3
