# api case plan mode
# plan AI 只输出 overrides → 平台拼报文 必须用新版 at-case-skill.md
# legacy AI 输出完整 requestBody 必须用旧版 skill（含 {structuredDoc} 等占位符）
API_CASE_PLAN_MODE=plan

# requirement platform sync
# 需求平台定时同步间隔（毫秒），0 关闭定时同步，仅手动同步
REQUIREMENT_SYNC_INTERVAL_MS=600000

# 敏行消息推送（OCU）
